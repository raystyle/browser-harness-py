# Copy to <BH_HOME>/.env (default ~/.config/browser-harness/.env) or
# <BH_HOME>/browser-workspace/.env — auto-loaded. Only needed for remote browsers.
BROWSER_USE_API_KEY=bu_your_key_here

# Local launch flags (only applied when browser-harness launches Chrome itself):
# BH_NO_THROTTLE=1          disable background/occlusion throttling for minimized windows
# BH_CHROME_EXTRA_FLAGS=    space-separated extra Chrome flags
# BH_IDLE_TIMEOUT=          persistent-task idle timeout in seconds (default
#                           1800 = 30 min; 0 disables). Daemon shuts down after
#                           this long with no request; the last daemon standing
#                           also closes the agent Chrome. One-shot/batch tasks
#                           (--once/--batch) ignore this — they tear down at
#                           invocation end regardless.

# IPC response budgets in seconds (Issue #3: cold-start Chrome + slow sites
# outlast tight budgets; unparseable/zero values fall back to the default):
# BH_IPC_TIMEOUT=           ordinary CDP round trips (default 5)
# BH_NAVIGATE_TIMEOUT=      Page.navigate via goto_url/new_tab (default 30)
# BH_SCREENSHOT_TIMEOUT=    Page.captureScreenshot (default 60)

# Runtime locations (defaults live under BH_HOME, i.e. ~/.config/browser-harness):
# BH_HOME=                  app data root (profile, workspace, recordings, tmp)
# BH_AGENT_CHROME_PROFILE=  agent Chrome user-data-dir (default <BH_HOME>/agent-chrome-profile)
# BH_BROWSER_WORKSPACE=     workspace dir (default <BH_HOME>/browser-workspace;
#                           legacy BH_AGENT_WORKSPACE still honored, pre-v0.6.8
#                           default agent-workspace/ is auto-renamed on first run)
